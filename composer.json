{
    "name": "2amigos/yii2-google-maps-library",
    "description": "Google Maps API library for Yii2.",
    "keywords": [
        "yii",
        "extension",
        "library",
        "google",
        "maps"
    ],
    "type": "yii-extension",
    "license": "BSD-3-Clause",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "2amigos",
            "email": "hola@2amigos.us",
            "homepage": "http://2amigos.us"
        },
        {
            "name": "Antonio Ramirez",
            "email": "hola@2amigos.us",
            "homepage": "https://2amigos.us"
        },
        {
            "name": "Anton Latul",
            "email": "webazex@gmail.com",
            "homepage": "https://latul.website"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-SimpleXML": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "yiisoft/yii2": "22.0.x-dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "dosamigos\\google\\maps\\": ""
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --verbose"
    }
}
